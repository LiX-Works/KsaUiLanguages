<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <KsaDir Condition="'$(KsaDir)' == ''">C:\Program Files\Kitten Space Agency</KsaDir>
    <LoaderDir Condition="'$(LoaderDir)' == ''">$(MSBuildThisFileDirectory)..\..\tools\StarMap-0.4.7</LoaderDir>
    <PluginDir Condition="'$(PluginDir)' == ''">$(MSBuildThisFileDirectory)..\..\work\build\KsaUiLanguages</PluginDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="KsaUiLanguages"><HintPath>$(PluginDir)\KsaUiLanguages.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="KSA"><HintPath>$(KsaDir)\KSA.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Brutal.Localization"><HintPath>$(KsaDir)\Brutal.Localization.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Brutal.ImGui"><HintPath>$(KsaDir)\Brutal.ImGui.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(LoaderDir)\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
